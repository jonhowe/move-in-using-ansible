{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "mode": "primary",
      "model": "litellm/openai/gpt-5.3-codex",
      "permissions": [
        {"action": "edit", "resource": "*", "effect": "allow"},
        {"action": "shell", "resource": "*", "effect": "allow"}
      ]
    },
    "plan": {
      "mode": "primary",
      "model": "litellm/openai/gpt-5.4",
      "permissions": [
        {"action": "edit", "resource": "*", "effect": "deny"},
        {"action": "shell", "resource": "*", "effect": "deny"}
      ]
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "litellm/xai/grok-code-fast-1",
      "system": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "permissions": [
        {"action": "edit", "resource": "*", "effect": "deny"}
      ]
    }
  },
  "plugins": ["{{ opencode_tokenscope_plugin }}"],
  "providers": {
    "litellm": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "settings": {
        "baseURL": "{{ opencode_provider_base_url }}"
      },
      "models": {
        "openai/gpt-5.3-codex": {
          "name": "openai/gpt-5.3-codex",
          "cost": {"input": 0.00003, "output": 0.00012},
          "limit": {"context": 128000, "output": 16000}
        },
        "openai/gpt-5.4": {
          "name": "openai/gpt-5.4",
          "cost": {"input": 0.000004, "output": 0.000016},
          "limit": {"context": 128000, "output": 4096}
        },
        "xai/grok-code-fast-1": {
          "name": "xai/grok-code-fast-1",
          "cost": {"input": 0.00002, "output": 0.00008},
          "limit": {"context": 128000, "output": 16000}
        },
        "anthropic/claude-haiku-4-5-20251001": {
          "name": "anthropic/claude-haiku-4-5-20251001",
          "cost": {"input": 0.00008, "output": 0.0004},
          "limit": {"context": 200000, "output": 4096}
        },
        "anthropic/claude-sonnet-4-6": {
          "name": "anthropic/claude-sonnet-4-6",
          "cost": {"input": 0.003, "output": 0.015},
          "limit": {"context": 200000, "output": 16000}
        },
        "anthropic/claude-opus-4-6": {
          "name": "anthropic/claude-opus-4-6",
          "cost": {"input": 0.015, "output": 0.075},
          "limit": {"context": 200000, "output": 16000}
        }
      }
    },
    "myriad360": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Myriad360",
      "settings": {
        "baseURL": "{{ opencode_provider_base_url }}"
      },
      "models": {
        "openai/gpt-5.4": {
          "name": "openai/gpt-5.4",
          "cost": {"input": 0.00003, "output": 0.00012},
          "limit": {"context": 128000, "output": 16000}
        },
        "openai/gpt-5.3-codex": {
          "name": "openai/gpt-5.3-codex",
          "cost": {"input": 0.00003, "output": 0.00012},
          "limit": {"context": 128000, "output": 16000}
        }
      }
    }
  }
}
