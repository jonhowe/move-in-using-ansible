---
# Copy this file to .env.yml and override only the values you want to change.
# The file is YAML even though the name starts with ".env" so nested Ansible
# variables remain easy to override. Replacing a list replaces the whole list.

user: yourusername
group: yourusername
home_directory: /home/yourusername

docker_add_user_to_group: true
downloads_migrate_existing: true

git_user_name: Example User
git_user_email: user@example.com

pipx_packages:
  - httpie

opencode_npm_version: "2.3.0"
opencode_provider_base_url: http://127.0.0.1:4001/v1
opencode_tokenscope_plugin: "@ramtinj95/opencode-tokenscope@2.1.0"

# Stable snap revisions are pinned in vars/main.yml. Copy an entry here only
# to replace that snap's revision. channel and revision cannot be combined.

optional_snap_applications:
  - name: joplin
    enabled: true
    install_method: snap
    snap_name: joplin-desktop
    classic: false
    revision: 169
  - name: todoist
    enabled: true
    install_method: snap
    snap_name: todoist
    classic: false
    revision: 1366
  - name: zoom
    enabled: true
    install_method: snap
    snap_name: zoom-client
    classic: false
    revision: 279
  - name: rambox
    enabled: true
    install_method: snap
    snap_name: rambox
    classic: false
    revision: 59

# Synaptics does not publish a checksum. Set one here only when the vendor does.
synaptics_repository_keyring_deb_checksum: ""
